{
	"name" : "1afa/sambadav",
	"description" : "SMB-to-WebDAV bridge, running smbclient on behalf of the user",
	"type" : "project",
	"license" : "AGPL-3.0-or-later",
	"require" : {
		"php" : ">=8.2",
		"ext-hash" : "*",
		"ext-openssl" : "*",
		"ext-zlib" : "*",
		"sabre/dav" : "^4.7"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^10.5 || ^11.5"
	},
	"suggest" : {
		"ext-ldap" : "Needed for the optional LDAP authentication check (ldap_auth)"
	},
	"authors" : [
		{
			"name" : "Richard de Vroede",
			"email" : "richard@1afa.com",
			"role" : "Developer"
		},
		{
			"name" : "Alfred Klomp",
			"email" : "alfred@1afa.com",
			"role" : "Initial creator"
		}
	],
	"autoload" : {
		"psr-4" : {
			"SambaDAV\\" : "lib/SambaDAV"
		}
	},
	"config" : {
		"optimize-autoloader" : true,
		"sort-packages" : true
	},
	"minimum-stability" : "stable"
}
